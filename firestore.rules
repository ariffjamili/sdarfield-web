rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Match the path used by the app: artifacts/{appId}/public/data/...
    match /artifacts/{appId}/public/data {
      
      // Comments Collection (Existing)
      match /comments/{commentId} {
        // Anyone can read comments
        allow read: if true;
        // Anyone can create a comment (public submission)
        allow create: if true;
        // Only authenticated admins can update (approve) or delete comments
        allow update, delete: if request.auth != null;
      }

      // --- NEW: Blog Posts Collection ---
      match /posts/{postId} {
        // Anyone can read blog posts
        allow read: if true;
        // Only authenticated admins can create, update, or delete posts
        allow write: if request.auth != null;
      }
      
    }
  }
}
